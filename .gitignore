# Build output / 编译产物
#
# 注意：这里的模式必须用前导 "/" 锚定到仓库根目录。
# 早先写成裸的 "cf-route-tester" 时，它同时匹配了**目录**
# cmd/cf-route-tester/，导致整个程序入口被忽略、仓库 clone 下来无法构建。
# 这类"忽略了不该忽略的东西"的错误，症状出现在别人那里而不是自己这里，
# 因此规则一律锚定根目录。
/bin/
/dist/
/cf-route-tester
/cf-route-tester.exe

# 二进制与库文件。用 "/" 前缀锚定，避免误伤同名目录。
/*.exe
*.dll
*.so
*.dylib

# Local data (never commit local databases or downloads) / 本地数据，禁止提交
/data/all.json
/data/all.txt
/data/results.db
/data/results.db-journal
/data/results.db-wal
/data/results.db-shm
/data/bin/
/data/raw/
/data/aggregate/
data/**/*.db
data/**/*.db-journal

# 结果 CSV（每轮扫描都会重写，不该进版本库）
/data/results.csv
dist/data/

# ASN 前缀缓存（从 RouteViews 抓取，约 1.7 MB）
#
# 用 **data/ 而不是 /data/：测试的工作目录是包目录，
# 因此缓存会落在 internal/xxx/data/asnprefix/ 下——那种东西
# 曾经被误提交过 30 个文件。这里连同嵌套位置一起忽略。
data/asnprefix/
**/data/asnprefix/

# Export output / 导出产物
/output/

# Config with local overrides / 本地配置覆盖
configs/local.yaml
configs/local.yml
*.local.yaml
*.local.yml

# Secrets: GitHub token etc. / 密钥，永远不要提交
.env
.env.*
*.token
gh_token.txt

# Test / coverage artifacts
#
# 刻意**不**写 "*.out"：那是一条在任意层级生效的规则，
# 而 Go 的包名里 ".out" 并不常见、却可能出现在目录名里。
# 只忽略 Go 工具链真正产出的那几个文件名，风险更低。
coverage.txt
coverage.html

# Editor / IDE
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# 测试若用到相对的默认目录，会在包目录下生成 data/。
# 那属于测试残留，不该进版本库（根目录的 data/ 另有自己的 .gitignore）。
internal/*/data/
internal/*/*/data/
